<script>
(function(){
  var stages = [
    ["Mortal",10],["Beginner",15],["Veteran",20],["Master",25],["Expert",30],
    ["Sage",40],["Lord",50],["Monarch",65],["Immortal",80],["Saint",100],
    ["Earth God",120],["Sky God",150],["Dao Completion",200]
  ];
  var btn = document.getElementById('meditate-btn');
  var fill = document.getElementById('cultivate-fill');
  var stageEl = document.getElementById('cultivate-stage');
  var qiEl = document.getElementById('cultivate-qi');
  if(!btn) return;

  var qi = Number(localStorage.getItem('cultivateQi')) || 0;
  var stageIndex = 0;

  function render(){
    var remaining = qi;
    var idx = 0;
    while(idx < stages.length - 1 && remaining >= stages[idx][1]){
      remaining -= stages[idx][1];
      idx++;
    }
    stageIndex = idx;
    var need = stages[idx][1];
    var pct = idx === stages.length - 1 ? 100 : Math.min(100, (remaining / need) * 100);
    fill.style.width = pct + '%';
    stageEl.textContent = stages[idx][0];
    qiEl.textContent = idx === stages.length - 1
      ? 'Dao Completion reached'
      : remaining + ' / ' + need + ' Qi';
  }

  btn.addEventListener('click', function(){
    if(stageIndex === stages.length - 1) return;
    qi += 1 + Math.floor(Math.random() * 3);
    localStorage.setItem('cultivateQi', qi);
    render();
  });

  render();
})();
</script>

